# Copy to .env.local. Never commit real values.

# Local filesystem editing (no GitHub, no Redis). `npm run dev` sets this.
# `npm run dev:prod` and Vercel production must set this to false.
TINA_PUBLIC_IS_LOCAL=true

# GitHub — write access to the private content repo only.
# Fine-grained PAT: Contents (read/write) on mllws/mllws-blog.
# Do not reuse the website's read-only BLOG_CONTENT_TOKEN.
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_OWNER=mllws
GITHUB_REPO=mllws-blog
GITHUB_BRANCH=main

# Auth.js — generate with: openssl rand -base64 32
# On Vercel, NEXTAUTH_URL must include the Tina Auth.js path, never blank.
# Example: https://mllws-cms-gamma.vercel.app/api/tina/auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3003/api/tina/auth

# Upstash Redis (Tina index cache). Either naming works:
# Vercel Marketplace KV_* or native Upstash UPSTASH_*.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Tina Redis key prefix. Bump this to re-seed users from mllws-blog
# (Users live in a detached Redis store, not the Git content namespace).
# TINA_INDEX_NAMESPACE=mllws-cms-v3

# Vercel Blob — public store for new photos. Token lives in Vercel env vars

# Vercel Blob — public store for new photos. Token lives in Vercel env vars
# and in .env.local only — never commit it.
BLOB_READ_WRITE_TOKEN=

